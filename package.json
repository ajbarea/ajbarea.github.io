{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "serve .output/public --listen 3000",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,ts,vue,jsx,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/robots": "^7.0.2",
    "@nuxtjs/sitemap": "^9.1.0",
    "@pinia/nuxt": "^1.0.2",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.17",
    "eslint": "^10.12.0",
    "feed": "^6.0.0",
    "nuxt": "^4.6.2",
    "photoswipe": "^5.4.4",
    "photoswipe-dynamic-caption-plugin": "^1.2.7",
    "pinia": "^4.0.3",
    "shiki": "^4.5.0",
    "vue": "^3.5.44",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@nuxt/test-utils": "^4.3.3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@vue/test-utils": "^2.5.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "exif-parser": "^0.1.12",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.18",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "nostics": "^1.2.0",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.6"
    },
    "serve": {
      "compression": "1.8.2"
    }
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "unrs-resolver": true
  }
}
